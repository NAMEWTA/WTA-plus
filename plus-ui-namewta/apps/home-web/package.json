{
  "$schema": "https://json.schemastore.org/package",
  "name": "@namewta/home-web",
  "version": "0.0.0",
  "private": true,
  "description": "NAMEWTA user portal and home web application",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "dev": "vite serve --mode development",
    "lint": "oxlint src vite.config.ts",
    "test": "vitest run src",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@namewta/adapter-axios-browser": "workspace:*",
    "@namewta/adapter-crypto-browser": "workspace:*",
    "@namewta/adapter-storage-browser": "workspace:*",
    "@namewta/domain-admin": "workspace:*",
    "@namewta/domain-profile": "workspace:*",
    "@namewta/domain-system": "workspace:*",
    "@namewta/platform-app-runtime": "workspace:*",
    "@namewta/platform-auth": "workspace:*",
    "@namewta/platform-permission": "workspace:*",
    "@namewta/web-domain-admin": "workspace:*",
    "@namewta/web-domain-profile": "workspace:*",
    "axios": "catalog:",
    "element-plus": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "catalog:",
    "autoprefixer": "10.5.4",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "engines": { "node": ">=20.19.0", "pnpm": ">=10.0.0" }
}
