<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.namewta.system.mapper.SysDeptMapper">

    <sql id="Tree_Structure_Columns">
        dept_id, parent_id, ancestors
    </sql>
    <select id="selectStructure" resultType="org.namewta.system.domain.SysDept">
        select <include refid="Tree_Structure_Columns"/> from sys_dept
        where dept_id = #{id} and del_flag = 0
        <if test="locking">for update</if>
    </select>
    <select id="lockTreeRoots" resultType="org.namewta.system.domain.SysDept">
        select <include refid="Tree_Structure_Columns"/> from sys_dept force index (PRIMARY)
        where del_flag = 0 and dept_id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        order by dept_id for update
    </select>
    <select id="selectVisibleForUpdate" resultType="org.namewta.system.domain.SysDept">
        select <include refid="Tree_Structure_Columns"/> from sys_dept
        where dept_id = #{id} and del_flag = 0 for update
    </select>
    <select id="selectTreeChildrenForUpdate" resultType="org.namewta.system.domain.SysDept">
        select <include refid="Tree_Structure_Columns"/> from sys_dept force index (idx_sys_dept_parent_id)
        where del_flag = 0 and parent_id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        order by dept_id for update
    </select>
</mapper>
