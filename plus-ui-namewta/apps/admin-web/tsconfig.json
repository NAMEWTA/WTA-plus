{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "../../node_modules/.tmp/admin-web.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts", "vite.config.ts", "vite/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/*"]
}
