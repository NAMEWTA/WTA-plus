map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream backend_server {
    ip_hash;
    server namewta-server1:8080 max_fails=3 fail_timeout=10s;
    server namewta-server2:8080 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    absolute_redirect off;
    port_in_redirect off;
    client_max_body_size 100m;
    root /usr/share/nginx/html;
    index index.html;

    location ~ ^(/[^/]*)?/actuator(?:/.*)?$ {
        return 403;
    }

    # LB 已剥离 App 前缀时，接口从根 /<env>-api 进入。
    location ~ ^/(?:dev-api|prod-api)/(.*)$ {
        rewrite ^/(?:dev-api|prod-api)/(.*)$ /$1 break;
        proxy_pass http://backend_server;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header REMOTE-HOST $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_buffering off;
        proxy_cache off;
    }

    # 独立端口访问保留 App 前缀，先剥前缀和 env-api 再转发后端。
    location ~ ^/${APP_PREFIX}/(?:dev-api|prod-api)/(.*)$ {
        rewrite ^/${APP_PREFIX}/(?:dev-api|prod-api)/(.*)$ /$1 break;
        proxy_pass http://backend_server;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header REMOTE-HOST $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_buffering off;
        proxy_cache off;
    }

    location = /${APP_PREFIX} {
        return 302 /${APP_PREFIX}/;
    }

    location /${APP_PREFIX}/ {
        rewrite ^/${APP_PREFIX}/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }

    # 统一 LB 会把 App 前缀剥离，因此根路径也必须能提供同一份 SPA。
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
