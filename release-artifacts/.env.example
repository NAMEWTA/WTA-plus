# 通用
NAMEWTA_BIND_HOST=127.0.0.1
NAMEWTA_DATA_ROOT=./runtime
NAMEWTA_NETWORK=namewta-network
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms512m -Xmx1024m

# 可选 OpenAPI；目标环境启用时使用同一 KEK 版本和合法的 32-byte Base64 KEK
OPENAPI_ENABLED=false
OPENAPI_KEK_VERSION=replace-with-an-openapi-kek-version
OPENAPI_KEK=replace-with-a-32-byte-base64-openapi-kek

# 前端路径与端口；管理端前缀不要使用 admin、monitor、snail-job 或 snail-ai
ADMIN_WEB_PREFIX=replace-with-private-prefix
LB_HTTP_PORT=40080
LB_HTTPS_PORT=40443
ADMIN_WEB_PORT=41080
LB_SERVER_NAME=localhost

# 数据库
MYSQL_DATABASE=wta-plus
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_APP_USER=namewta_app
MYSQL_APP_PASSWORD=replace-with-a-strong-application-password

# 可选 Nacos；只在组合 docker/overrides/nacos-enabled.yml 时使用
NACOS_DB_NAME=nacos
NACOS_DB_USER=nacos
NACOS_DB_PASSWORD=replace-with-a-strong-nacos-database-password
NACOS_AUTH_TOKEN=replace-with-a-base64-secret-longer-than-32-bytes
NACOS_AUTH_IDENTITY_KEY=replace-with-a-private-server-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-a-private-server-identity-value
NACOS_CONFIG_USERNAME=nacos
NACOS_CONFIG_PASSWORD=replace-after-first-console-password-initialization
NACOS_CONFIG_NAMESPACE_LOCAL=local
NACOS_CONFIG_NAMESPACE_DEV=dev
NACOS_CONFIG_NAMESPACE_PROD=prod

# Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password

# MinIO
MINIO_ROOT_USER=namewta
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_ENDPOINT=replace-with-server-reachable-minio-endpoint
MINIO_BUCKET=wta
MINIO_DIAGNOSTIC_OBJECT=.well-known/oss-readiness/private-canary.txt
# Comma-separated browser Origins allowed to upload directly to MinIO.
MINIO_API_CORS_ALLOW_ORIGIN=*

# Spring Boot Admin；客户端与服务端使用同一组凭据
MONITOR_USERNAME=replace-with-monitor-user
MONITOR_PASSWORD=replace-with-a-strong-monitor-password

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# 可选 AI 服务
SNAIL_JOB_ENABLED=false
SNAIL_AI_ENABLED=false
SNAIL_AI_RAG_DOCLING_ENABLED=false
SNAIL_AI_RAG_DOCLING_URL=http://host.docker.internal:5100
SNAIL_AI_RAG_DOCLING_PADDLE_OCR_ENABLED=false
SNAIL_AI_RAG_DOCLING_PADDLE_OCR_URL=http://host.docker.internal:8866/ocr
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.4.2

# 可覆盖镜像标签
NGINX_IMAGE=nginx:1.31.1
NAMEWTA_ADMIN_IMAGE=namewta/namewta-admin:6.0.0
NAMEWTA_MONITOR_IMAGE=namewta/namewta-monitor-admin:6.0.0
NAMEWTA_SNAILJOB_IMAGE=namewta/namewta-snailjob-server:6.0.0
NAMEWTA_SNAILAI_IMAGE=namewta/namewta-snailai-server:6.0.0
HOME_WEB_PREFIX=home
HOME_WEB_PORT=41082
