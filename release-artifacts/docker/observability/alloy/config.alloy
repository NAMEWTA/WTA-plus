local.file_match "namewta_logs" {
  path_targets = [
    { "__path__" = "/var/log/wta/server1/*.log", "service" = "namewta-admin", "instance" = "server1", "job" = "namewta" },
    { "__path__" = "/var/log/wta/server2/*.log", "service" = "namewta-admin", "instance" = "server2", "job" = "namewta" },
    { "__path__" = "/var/log/wta/monitor/**/*.log", "service" = "namewta-monitor-admin", "instance" = "monitor", "job" = "namewta" },
    { "__path__" = "/var/log/wta/snailjob/**/*.log", "service" = "namewta-snailjob-server", "instance" = "snailjob", "job" = "namewta" },
  ]
}

loki.source.file "namewta_logs" {
  targets    = local.file_match.namewta_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
