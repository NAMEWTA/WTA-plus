    </dependencies>


    <profiles>
        <!-- 默认全量部署组合；显式激活其他 bundle-* profile 时自动停用 -->
        <profile>
            <id>bundle-full</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <!-- 调度任务模块 -->
                <dependency>
                    <groupId>org.namewta</groupId>
                    <artifactId>wta-job</artifactId>
                </dependency>

                <!-- AI业务模块 -->
                <dependency>
                    <groupId>org.namewta</groupId>
                    <artifactId>wta-ai</artifactId>
                </dependency>

                <!-- demo模块 -->
                <dependency>
                    <groupId>org.namewta</groupId>
                    <artifactId>wta-demo</artifactId>
                </dependency>

                <!-- 工作流模块 -->
                <dependency>
                    <groupId>org.namewta</groupId>
                    <artifactId>wta-workflow</artifactId>
                </dependency>

                <!-- 档案模块 -->
                <dependency>
                    <groupId>org.namewta</groupId>
                    <artifactId>wta-profile-person</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.namewta</groupId>
                    <artifactId>wta-profile-enterprise</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!-- 显式激活后停用 bundle-full，仅保留上方平台基础依赖。 -->
        <profile>
            <id>bundle-core</id>
            <dependencies>
                <!-- Core 保留档案查询与草稿能力，但不装配工作流引擎。 -->
                <dependency>
                    <groupId>org.namewta</groupId>
                    <artifactId>wta-profile-person</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.namewta</groupId>
                    <artifactId>wta-profile-enterprise</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven-war-plugin.version}</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <warName>${project.artifactId}</warName>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
