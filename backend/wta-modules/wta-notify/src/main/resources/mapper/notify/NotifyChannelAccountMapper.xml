<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.namewta.notify.mapper.NotifyChannelAccountMapper">
    <!-- 有意包含 del_flag=1 的保留标识；不读取或暴露账号凭据。 -->
    <select id="existsNamespace" resultType="boolean">
        select exists(select 1 from notify_channel_account where channel = #{channel} and config_key = #{configKey})
    </select>
</mapper>
