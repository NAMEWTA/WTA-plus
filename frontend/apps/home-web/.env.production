# Home Web 生产构建公开配置。全部 VITE_* 会进入浏览器产物，禁止写入密钥。
# 发布时 release-manage.sh 会覆盖 CONTEXT_PATH 与 BASE_API 为 /<prefix>/ 与 /<prefix>/prod-api。

VITE_APP_TITLE=WTA-Plus Home
VITE_APP_CONTEXT_PATH=/
VITE_APP_BASE_API=/prod-api
VITE_APP_BASE_URL=/
VITE_APP_CLIENT_ID=428a8310cd442757ae699df5d894f051
VITE_APP_ENV=production
