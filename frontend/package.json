{
  "$schema": "https://json.schemastore.org/package",
  "name": "wta-vue-plus",
  "version": "6.0.0",
  "private": true,
  "description": "NAMEWTA frontend workspace",
  "license": "MIT",
  "author": "LionLi",
  "repository": {
    "type": "git",
    "url": "https://github.com/NAMEWTA/WTA-plus.git"
  },
  "type": "module",
  "scripts": {
    "architecture:check": "namewta-architecture check --root .",
    "architecture:test": "pnpm --filter @namewta/architecture test",
    "build": "pnpm build:prod",
    "build:dependencies": "pnpm -r --workspace-concurrency=1 --filter '!./apps/**' --filter '!wta-vue-plus' --if-present build",
    "build:dev": "pnpm architecture:check && pnpm build:dependencies && pnpm --filter @namewta/admin-web build:dev && pnpm --filter @namewta/home-web build:dev && pnpm --filter @namewta/sso-web build:dev",
    "build:prod": "pnpm architecture:check && pnpm build:dependencies && pnpm --filter @namewta/admin-web build:prod && pnpm --filter @namewta/home-web build:prod && pnpm --filter @namewta/sso-web build:prod",
    "build:workspace": "pnpm build:prod",
    "dev": "pnpm --filter @namewta/admin-web dev",
    "fmt": "oxfmt apps packages tooling e2e playwright.config.ts vitest.config.ts",
    "lint": "oxlint e2e playwright.config.ts vitest.config.ts && pnpm lint:workspace",
    "lint:fix": "pnpm --filter @namewta/admin-web lint:fix",
    "lint:workspace": "pnpm architecture:check && pnpm -r --if-present lint",
    "preview": "pnpm --filter @namewta/admin-web preview",
    "test": "pnpm test:workspace",
    "test:e2e": "playwright test",
    "test:workspace": "pnpm architecture:check && pnpm -r --if-present test",
    "typecheck": "pnpm typecheck:workspace",
    "typecheck:workspace": "pnpm architecture:check && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@namewta/architecture": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "catalog:",
    "@types/nprogress": "0.2.3",
    "@unocss/preset-attributify": "66.7.5",
    "@unocss/preset-wind3": "66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "catalog:",
    "autoprefixer": "10.5.4",
    "oxfmt": "^0.60.0",
    "oxlint": "catalog:",
    "sass": "1.102.0",
    "typescript": "catalog:",
    "unocss": "66.7.5",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "unplugin-vue-setup-extend-plus": "1.0.1",
    "vite": "^8.1.5",
    "vite-plugin-svg-icons-ng": "^1.9.2",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "browserslist": [
    "Chrome >= 87",
    "Edge >= 88",
    "Safari >= 14",
    "Firefox >= 78"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
