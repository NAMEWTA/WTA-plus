  {
    "path": "frontend/package.json",
    "name": "wta-vue-plus",
    "scripts": {
      "architecture:check": "namewta-architecture check --root .",
      "architecture:test": "pnpm --filter @namewta/architecture test",
      "build": "pnpm build:prod",
      "build:dev": "pnpm architecture:check && pnpm --filter @namewta/admin-web build:dev && pnpm --filter @namewta/home-web build:dev && pnpm build:workspace:non-admin",
      "build:prod": "pnpm build:workspace",
      "build:workspace": "pnpm architecture:check && pnpm -r --if-present build",
      "build:workspace:non-admin": "pnpm -r --filter '!@namewta/admin-web' --if-present build",
      "dev": "pnpm --filter @namewta/admin-web dev",
      "fmt": "oxfmt apps packages tooling e2e playwright.config.ts vitest.config.ts",
      "lint": "oxlint e2e playwright.config.ts vitest.config.ts && pnpm lint:workspace",
      "lint:fix": "pnpm --filter @namewta/admin-web lint:fix",
      "lint:workspace": "pnpm architecture:check && pnpm -r --if-present lint",
      "preview": "pnpm --filter @namewta/admin-web preview",
      "test": "pnpm test:workspace",
      "test:e2e": "playwright test",
      "test:workspace": "pnpm architecture:check && pnpm -r --if-present test",
      "typecheck": "pnpm typecheck:workspace",
      "typecheck:workspace": "pnpm architecture:check && pnpm -r --if-present typecheck"
    },
    "dependencies": {
      "@namewta/architecture": "workspace:*"
    }
  },
