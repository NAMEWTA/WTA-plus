        <dependency>
            <groupId>org.namewta</groupId>
            <artifactId>wta-common-doc</artifactId>
        </dependency>

        <!-- 授权认证 -->
        <dependency>
            <groupId>org.namewta</groupId>
            <artifactId>wta-common-social</artifactId>
        </dependency>

        <!-- 邮件服务 -->
        <dependency>
            <groupId>org.namewta</groupId>
            <artifactId>wta-common-mail</artifactId>
        </dependency>

        <!-- 统一通知服务 -->
        <dependency>
            <groupId>org.namewta</groupId>
            <artifactId>wta-common-notify</artifactId>
        </dependency>

        <!-- 可选 Nacos 动态配置 -->
        <dependency>
            <groupId>org.namewta</groupId>
            <artifactId>wta-common-nacos</artifactId>
        </dependency>

        <!-- mcp模块 -->
        <dependency>
            <groupId>org.namewta</groupId>
            <artifactId>wta-common-mcp</artifactId>
        </dependency>

        <!-- OpenAPI machine invocation assembly -->
        <dependency>
            <groupId>org.namewta</groupId>
            <artifactId>wta-common-openapi</artifactId>
