# Home Web 开发环境公开配置。全部 VITE_* 会进入浏览器产物，禁止写入数据库/Redis/MinIO 密码。
# 生产构建使用同目录 .env.production；发布脚本会覆盖 CONTEXT_PATH 与 BASE_API。
# 本机私有覆盖使用未被跟踪的 .env.development.local。

VITE_APP_TITLE=WTA-Plus Home
VITE_APP_PORT=5175
VITE_APP_CONTEXT_PATH=/
VITE_APP_BASE_API=/dev-api
VITE_APP_BASE_URL=/
VITE_APP_PROXY_TARGET=http://127.0.0.1:18080
# sys_client.client_id，用户端 app
VITE_APP_CLIENT_ID=428a8310cd442757ae699df5d894f051
VITE_APP_ENV=development
VITE_APP_ENCRYPT=true
