# Admin Web 开发环境公开配置。全部 VITE_* 会进入浏览器产物，禁止写入数据库/Redis/MinIO 密码。
# 生产构建使用同目录 .env.production；发布脚本会覆盖 CONTEXT_PATH 与 BASE_API。
# 本机私有覆盖使用未被跟踪的 .env.development.local。

# 页面标题
VITE_APP_TITLE=WTA-Plus Admin
# Vite 开发端口；生产由 Nginx/发布端口台账决定，不读此项
VITE_APP_PORT=5177
# 部署子路径。开发为 /；生产由 release-manage.sh 写成 /<prefix>/
VITE_APP_CONTEXT_PATH=/
# 前端 API 前缀。开发由 Vite 代理到 VITE_APP_PROXY_TARGET；生产为 /<prefix>/prod-api
VITE_APP_BASE_API=/dev-api
VITE_APP_BASE_URL=/
# 仅开发代理目标；生产走 Nginx，不使用此项
VITE_APP_PROXY_TARGET=http://127.0.0.1:38888
# sys_client.client_id，管理端 pc
VITE_APP_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e
VITE_APP_ENV=development
VITE_APP_MESSAGE_ENABLED=false
