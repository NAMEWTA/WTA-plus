# Admin Web 生产构建公开配置。全部 VITE_* 会进入浏览器产物，禁止写入密钥。
# 发布时 release-manage.sh 会覆盖 CONTEXT_PATH 与 BASE_API 为 /<prefix>/ 与 /<prefix>/prod-api。
# 本机私有覆盖使用未被跟踪的 .env.production.local。

VITE_APP_TITLE=WTA-Plus Admin
VITE_APP_CONTEXT_PATH=/
VITE_APP_BASE_API=/prod-api
VITE_APP_BASE_URL=/
VITE_APP_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e
VITE_APP_ENV=production
# Only controls realtime hints; the persisted message inbox remains available.
VITE_APP_MESSAGE_ENABLED=false
